# Copy this file to .streamlit/secrets.toml and fill in your own project's
# values (Supabase dashboard -> Settings -> API). Do NOT commit the real
# secrets.toml — it's already excluded in .gitignore.
#
# For the deployed app, paste the same two lines into Streamlit Community
# Cloud: your app -> Settings -> Secrets.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
